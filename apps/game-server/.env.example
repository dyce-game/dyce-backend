# Copy to .env for local development. Never commit real secrets.
# A production template with every variable documented: ../../deploy/production.env.example
PORT=2567

# Same login role as the API (a member of dyce_api, NOT a superuser).
DATABASE_URL="postgres://dyce_app:dyce_app@localhost:54329/dyce"
# Must equal the API's JWT_SECRET: the game server verifies the access tokens the API issues.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-the-same-48-random-characters-as-the-api
# Must equal the API's INTERNAL_SECRET: signs the API's "start this room" calls to the game server.
INTERNAL_SECRET=replace-with-the-same-32-or-more-random-characters-as-the-api

# A seat offline this long forfeits (SPEC: 60 s). Seats have JOIN_GRACE_SECONDS to connect after a room starts.
RECONNECT_SECONDS=60
JOIN_GRACE_SECONDS=90

# Operations (all optional). No SENTRY_DSN = error reporting is off.
# LOG_LEVEL=info
# LOG_FORMAT=pretty
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# RELEASE=
# SHUTDOWN_DRAIN_MS=0
# SHUTDOWN_TIMEOUT_MS=25000
