# Copy to .env for local development. Never commit real secrets.
PORT=2567

# Same login role as the API (a member of dyce_api, NOT a superuser).
DATABASE_URL=postgres://dyce_app:dyce_app@localhost:5432/dyce

# Must equal the API's JWT_SECRET: the game server verifies the access tokens the API issues.
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Must equal the API's INTERNAL_SECRET: signs the API's "start this room" calls to the game server.
INTERNAL_SECRET=change-me-to-another-long-random-string-of-at-least-32-chars

# A seat offline this long forfeits (SPEC: 60 s). Seats have JOIN_GRACE_SECONDS to connect after a room starts.
RECONNECT_SECONDS=60
JOIN_GRACE_SECONDS=90
