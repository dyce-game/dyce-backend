{
  "name": "@dyce/game-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsc -p tsconfig.build.json && node --watch --env-file-if-exists=.env dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test": "jest --selectProjects unit",
    "test:db": "node test/run-with-pg.mjs",
    "e2e": "node scripts/live-e2e.mjs"
  },
  "dependencies": {
    "@colyseus/core": "^0.16.26",
    "@colyseus/ws-transport": "^0.16.5",
    "@dyce/games": "workspace:*",
    "@dyce/shared": "workspace:*",
    "@sentry/node": "^11.16.0",
    "jose": "^6.2.17",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "colyseus.js": "^0.16.22",
    "embedded-postgres": "17.11.0-beta.19",
    "jest": "^29.7.0"
  }
}
