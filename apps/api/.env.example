# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=3000

# Login role that is a member of dyce_api (NOT a superuser). See db/migrations/0006_roles_and_config.sql.
DATABASE_URL="postgres://dyce_app:dyce_app@localhost:54329/dyce"

# Secrets: generate with `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
JWT_SECRET=replace-with-48-random-characters-generated-as-above
# Hashes phone numbers and OTP codes. Rotating it breaks contact matching, so treat it like a database key.
PHONE_HASH_SALT=replace-with-48-random-characters-generated-as-above

# Sessions
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
OTP_TTL_SECONDS=300

# Local development: "console" prints the code (with the number masked) to this log instead of sending an SMS.
SMS_DRIVER=console
# Non-production only. A fixed 6-digit code, no SMS sent. For Maestro and quick manual testing.
# The API refuses to start in production if this is set.
OTP_TEST_CODE=424242
# Demo accounts for store review (production too): `+2348012345678=482913;review@mail.dyce.games=739104`. See auth/review-logins.ts.
# REVIEW_LOGINS=

# Real SMS (SMS_DRIVER=real): +234 numbers go to Termii first, then fall back to Twilio; everything else uses Twilio.
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_BASE_URL=
TERMII_CHANNEL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# Email sign-in and sign-up (ADR-044). "console" prints the code (the address is masked) instead of emailing it.
# OTP_TEST_CODE above also applies to email in development. Set EMAIL_AUTH_ENABLED=false to switch email sign-in off.
EMAIL_AUTH_ENABLED=true
EMAIL_DRIVER=console
# Real email (EMAIL_DRIVER=resend): a Resend API key and a sender on a domain you verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
RESEND_BASE_URL=

# Behind a load balancer: how many proxy hops to trust for the client IP (used by rate limiting). 0 = none.
TRUST_PROXY_HOPS=0

# Where invite links point (the web build that serves /i/<token>). Dev: the Expo web dev server.
INVITE_BASE_URL=http://localhost:8081

# Live Spaces: the Colyseus game server (apps/game-server). INTERNAL_SECRET must equal the game server's.
# GAME_SERVER_URL is where the API reaches it; GAME_SERVER_PUBLIC_URL is the ws(s) address handed to apps
# (defaults to GAME_SERVER_URL with the scheme swapped). Without INTERNAL_SECRET, rooms cannot be started.
GAME_SERVER_URL=http://localhost:2567
GAME_SERVER_PUBLIC_URL=ws://localhost:2567
INTERNAL_SECRET=replace-with-32-or-more-random-characters-shared-with-the-game-server

# Push notifications: "console" prints them (development); "expo" sends through the Expo Push API (required in production).
PUSH_DRIVER=console
# EXPO_ACCESS_TOKEN=

# Pool entry device check (ADR-039). "dev" passes every device and is refused in production; "store" is the
# Play Integrity / App Attest driver, which fails closed until a person finishes it. The check only blocks Pool
# when app_config integrity_required is true.
INTEGRITY_DRIVER=dev

# The moderation API (ADR-039). Needs a login role that is a member of dyce_admin, and tokens: "name:token,name:token"
# (names a-z0-9_.-, tokens 32+ random characters; the name is written to the audit log). Leave both empty to switch it off.
# ADMIN_DATABASE_URL=postgres://dyce_moderator:change-me@localhost:5432/dyce
# ADMIN_TOKENS=

# --- Operations (all optional; docs/RUNBOOK.md, docs/MONITORING.md in the Dyce repo) ---
# A production template with every variable documented: ../../deploy/production.env.example
# LOG_LEVEL=info
# LOG_FORMAT=pretty
# Empty SENTRY_DSN = error reporting is off and the library is not even loaded.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=0
# RELEASE=
# SHUTDOWN_DRAIN_MS=0
# SHUTDOWN_TIMEOUT_MS=25000
# Nightly money check (02:15 Africa/Lagos). Alerts go to the log and Sentry; set a webhook to reach a person.
# LEDGER_CHECK_ENABLED=true
# LEDGER_CHECK_FREEZE=true
# ALERT_WEBHOOK_URL=
# LEDGER_CHECK_HEARTBEAT_URL=
