# =====================================================================================================================
# Dyce production configuration. EVERY variable the API and the game server read is listed here, with what it does,
# whether it is required, and what happens if it is wrong. A unit test (apps/api/src/config/env-example.test.ts)
# fails if a variable is added to the API's schema without being documented here.
#
# This file is a TEMPLATE. Real values live in your platform's secret store (never in git, never in an image).
# Lines starting with "#" and a variable name are optional settings left at their default.
#
#   [API]  = apps/api       [GAME] = apps/game-server       [BOTH] = the same value in both
#   (secret) = treat like a database password: store in the secret manager, rotate per docs/RUNBOOK.md
# =====================================================================================================================

# ---- Runtime --------------------------------------------------------------------------------------------------
# [API] "production" turns on the production safety checks: SMS_DRIVER must be "real", PUSH_DRIVER must be "expo",
# OTP_TEST_CODE must be unset. The API REFUSES TO START otherwise.
NODE_ENV=production
# [API] Listen port. [GAME] has its own PORT below.
PORT=3000
# [API][GAME] Build identifier (git sha). Shown by /health/ready, put on every log line and Sentry event. The Docker
# images set it from the RELEASE build arg; only override it if you do not use those images.
# RELEASE=

# ---- Database -------------------------------------------------------------------------------------------------
# [API][GAME] (secret) The login role used at runtime: a member of dyce_api, NEVER a superuser, no write access to
# ledger tables (that is what keeps money safe even if the API is compromised). Create it once, before the first
# migration: see deploy/postgres/init-roles.sql. Use sslmode=require for a managed database.
# Use a DIRECT or SESSION-mode connection, NOT a transaction-mode pooler (for example port 6543 on Supabase): the
# migrator takes a session advisory lock, which a transaction pooler does not keep on one connection.
DATABASE_URL=postgres://dyce_app:CHANGE_ME@db.internal:5432/dyce?sslmode=require
# [migrate step only] (secret) The OWNER role that runs migrations (it creates tables and functions). Used by the
# deploy step `node db/migrate.ts` as its DATABASE_URL. Never given to the running API or game server.
# MIGRATION_DATABASE_URL=postgres://dyce_owner:CHANGE_ME@db.internal:5432/dyce?sslmode=require

# ---- Secrets (generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))") ---
# [BOTH] (secret) HS256 key for access tokens, >= 32 chars. The game server verifies the tokens the API issues, so
# the two MUST match. Rotating signs everyone out (acceptable); see docs/RUNBOOK.md "Rotating secrets".
JWT_SECRET=CHANGE_ME_48_RANDOM_CHARS_AT_LEAST_32
# [API] (secret) Keyed hash for phone numbers and OTP codes, >= 32 chars. ROTATING IT BREAKS CONTACT MATCHING FOR
# EVERY USER (their stored hashes stop matching). Treat it like a database encryption key: back it up, never rotate
# casually.
PHONE_HASH_SALT=CHANGE_ME_48_RANDOM_CHARS_AT_LEAST_32
# [BOTH] (secret) Signs the API's "start this room" calls to the game server, >= 32 chars. Without it Spaces cannot
# start live games. Must be identical in the API and the game server.
INTERNAL_SECRET=CHANGE_ME_32_OR_MORE_RANDOM_CHARS

# ---- Sessions -------------------------------------------------------------------------------------------------
# [API] Access token lifetime. Short on purpose: a stolen token expires quickly. Default 900 (15 min).
# JWT_ACCESS_TTL_SECONDS=900
# [API] Refresh token lifetime in days. Default 30.
# REFRESH_TTL_DAYS=30
# [API] How long a texted one-time code is valid. Default 300 (5 min).
# OTP_TTL_SECONDS=300
# [API] Development only. A fixed 6-digit code that skips SMS. MUST be unset in production (the API refuses to start
# if it is set). Listed so nobody sets it by accident.
# OTP_TEST_CODE=

# [API] Demo accounts for App Store and Google Play review (Apple 2.1(a) needs a way in for the reviewer, who cannot
# receive an SMS or an email). Up to four `identity=code` pairs, separated by `;`: a full international number or an
# email address, then a 6-digit code nobody could guess. Only those identities accept that code and nothing is sent to
# them; every limit still applies. Set it before submitting, put the same pairs in App Review's notes, and rotate or
# remove it afterwards (docs/APP_REVIEW_NOTES.md in the app repo).
# REVIEW_LOGINS=+2348012345678=482913;review@mail.dyce.games=739104

# ---- SMS (phone sign-in codes and invites) ---------------------------------------------------------------------
# [API] "real" in production (required). "console" only prints codes to the log, with the number masked.
SMS_DRIVER=real
# [API] Nigerian (+234) numbers go to Termii first and fall back to Twilio; all other numbers use Twilio. Configure
# BOTH for failover (docs/RUNBOOK.md "SMS provider failover"). At least one provider is required when SMS_DRIVER=real.
TERMII_API_KEY=
# [API] Registered Termii sender id (must be approved by Termii/the carriers for the DND route).
TERMII_SENDER_ID=
# [API] Override only for a regional Termii endpoint. Default: the provider's standard URL.
# TERMII_BASE_URL=
# [API] "dnd" (delivers to numbers on Do-Not-Disturb, needs an approved sender), "generic" or "whatsapp".
# TERMII_CHANNEL=
# [API] (secret) Twilio credentials: account sid + auth token + EITHER a from number OR a messaging service sid.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# TWILIO_MESSAGING_SERVICE_SID=

# ---- Email (sign up and log in with email, via Resend; ADR-044) -------------------------------------------------
# [API] "true" offers "Sign up with email" and "Log in with email" in the app. "false" switches them off (the routes answer
# 404 and the app hides the buttons). In production, "true" REQUIRES EMAIL_DRIVER=resend or the API refuses to start.
EMAIL_AUTH_ENABLED=true
# [API] "resend" in production (required while EMAIL_AUTH_ENABLED is true). "console" only prints codes to the log.
EMAIL_DRIVER=resend
# [API] (secret) Resend API key with "Sending access" restricted to your sending domain (docs/SETUP_GUIDE.md section 4).
RESEND_API_KEY=
# [API] The sending address on a domain verified in Resend, e.g. Dyce <login@mail.dyce.games>. SPF, DKIM and DMARC
# must be set up first or sign-in codes go to spam.
EMAIL_FROM=
# [API] Optional reply-to, e.g. support@dyce.games. Leave empty for no reply-to.
# EMAIL_REPLY_TO=
# [API] Tests and proxies only. Default: https://api.resend.com
# RESEND_BASE_URL=

# ---- Push notifications ----------------------------------------------------------------------------------------
# [API] "expo" in production (required): sends through the Expo Push API. "console" only prints.
PUSH_DRIVER=expo
# [API] (secret) Optional Expo access token (enables "enhanced push security" on the Expo project).
# EXPO_ACCESS_TOKEN=

# ---- Network and web -------------------------------------------------------------------------------------------
# [API] How many reverse-proxy hops to trust for the client IP (rate limiting uses it). Set to the number of proxies
# in front of the API (e.g. 1 behind a single load balancer). WRONG VALUE = everyone shares one rate-limit bucket (too
# high a number lets a client spoof its IP; 0 behind a proxy rate-limits the proxy itself). Default 0.
TRUST_PROXY_HOPS=1
# [API] Comma-separated browser origins allowed to call the API: the web guest game's origin. Native apps need no
# CORS. Empty = none.
CORS_ORIGINS=https://dyce.games
# [API] Where invite links point: the web build serving /i/<token>. Default https://dyce.games.
INVITE_BASE_URL=https://dyce.games

# ---- Live games (Spaces) ---------------------------------------------------------------------------------------
# [API] Where the API reaches the game server (private network address is fine).
GAME_SERVER_URL=http://game-server.internal:2567
# [API] The public ws(s) address handed to apps. Defaults to GAME_SERVER_URL with the scheme swapped, which is wrong
# when the game server is behind a TLS-terminating load balancer: set it explicitly (wss://game.dyce.games).
GAME_SERVER_PUBLIC_URL=wss://game.dyce.games
# [GAME] Listen port of the game server (a separate service from the API).
# PORT=2567   (set in the game server's own environment; shown here so the name is documented)
# [GAME] How long a disconnected seat may stay offline before it forfeits (SPEC: 60). Default 60.
RECONNECT_SECONDS=60
# [GAME] How long seats have to connect after a room is created. Default 90.
JOIN_GRACE_SECONDS=90

# ---- Device integrity and moderation (ADR-039) -----------------------------------------------------------------
# [API] "store" in production (required: the API refuses to start with "dev", which passes every device). Only
# consulted when the app_config key `integrity_required` is true. "store" fails CLOSED until the Play Integrity /
# App Attest verification is written and configured, so with `integrity_required=true` nobody can enter a Pool.
# LAUNCH DECISION for the human owner: see docs/RELEASE_CHECKLIST.md "Device integrity".
INTEGRITY_DRIVER=store
# [API] (secret) Login role in dyce_admin for the moderation API (it has its own database role). Both this and
# ADMIN_TOKENS must be set or the admin routes answer 404.
# ADMIN_DATABASE_URL=postgres://dyce_admin_login:CHANGE_ME@db.internal:5432/dyce?sslmode=require
# [API] (secret) Moderators' API tokens as `name:token,name:token`; each token 32+ chars. One entry per person so
# actions are attributable; remove an entry to revoke.
# ADMIN_TOKENS=

# ---- Logging and error reporting -------------------------------------------------------------------------------
# [BOTH] error | warn | info | debug. Default info. debug is for short investigations only.
LOG_LEVEL=info
# [BOTH] "json" (default in production: one object per line for the log shipper) or "pretty" (terminal).
# LOG_FORMAT=json
# [BOTH] Sentry project DSN. EMPTY = error reporting is off and the Sentry library is not even loaded. Events are
# scrubbed (no phone numbers, tokens, headers, bodies or query strings) before they leave the process.
SENTRY_DSN=
# [BOTH] Environment tag in Sentry. Default: NODE_ENV.
SENTRY_ENVIRONMENT=production
# [BOTH] 0..1, share of requests traced. Default 0 (off). Raise only with a measured reason: tracing costs money.
# SENTRY_TRACES_SAMPLE_RATE=0

# ---- Graceful shutdown -----------------------------------------------------------------------------------------
# [BOTH] On SIGTERM the service answers 503 on /health/ready for this long BEFORE it closes, so the load balancer
# stops routing to it first. Set to a little more than the load balancer's health-check interval x unhealthy threshold.
# Default 0 (no drain). Must be less than the platform's stop timeout.
SHUTDOWN_DRAIN_MS=5000
# [BOTH] Hard stop: exit even if shutdown has not finished. Keep below the platform's kill timeout. Default 25000.
# SHUTDOWN_TIMEOUT_MS=25000

# ---- Money check and alerting ----------------------------------------------------------------------------------
# [API] Where critical alerts are posted (a Slack incoming webhook; Discord webhooks accept the same body). Empty =
# alerts reach only the log and Sentry, which is NOT enough for the money check: set this before launch.
ALERT_WEBHOOK_URL=
# [API] The nightly ledger_check_invariants job at 02:15 Africa/Lagos. Leave "true" everywhere real money-like
# balances exist. The "clean for 14 days" launch gate reads its history (node db/ledger-gate.ts).
LEDGER_CHECK_ENABLED=true
# [API] If a wallet disagrees with the ledger, freeze Pool for that user until a human clears it. Default true.
LEDGER_CHECK_FREEZE=true
# [API] A dead-man's-switch URL (healthchecks.io style) pinged after every CLEAN run. The monitor alerts when pings
# STOP, which catches "the job is not running at all", the one failure the in-process alert cannot report.
LEDGER_CHECK_HEARTBEAT_URL=
